# Server Environment Configuration
PORT=4000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# Delivery Worker Configuration
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_LEASE_TIMEOUT_MS=60000
DELIVERY_TIMEOUT_MS=10000
MAX_RESPONSE_BODY_BYTES=8192

# SSRF and Network Security Configuration
# Set to 'true' only in local development or test suites to allow targeting local test servers
ALLOW_LOCAL_DESTINATIONS=false

# Ingestion limits
MAX_PAYLOAD_BYTES=1048576

# Allowed Frontend Origins (comma-separated, or '*' for open access)
# In production on Render, set to your Vercel frontend URL, e.g. https://your-hookrelay.vercel.app
CORS_ORIGIN="*"

# Database Provider note:
# For local dev: DATABASE_URL="file:./dev.db" (SQLite)
# For production (Render / Neon / Supabase): DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

