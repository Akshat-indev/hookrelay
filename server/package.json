{
  "name": "hookrelay-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API and delivery worker for HookRelay",
  "main": "src/server.js",
 "scripts": {
    "build": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "start:all": "node src/index.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch --env-file=.env src/worker.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:generate:postgres": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:push:postgres": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ipaddr.js": "^2.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "vitest": "^3.0.7"
  }
}
