{
  "name": "hookrelay-monorepo",
  "version": "1.0.0",
  "description": "HookRelay - Webhook Delivery, Retry & Observability Platform",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "setup:db": "npm --workspace=server run db:push",
    "dev": "concurrently -n \"api,worker,client\" -c \"blue,green,magenta\" \"npm --workspace=server run dev\" \"npm --workspace=server run worker:dev\" \"npm --workspace=client run dev\"",
    "dev:api": "npm --workspace=server run dev",
    "dev:worker": "npm --workspace=server run worker:dev",
    "dev:client": "npm --workspace=client run dev",
    "worker": "npm --workspace=server run worker",
    "build": "npm --workspace=client run build",
    "test": "npm --workspace=server run test",
    "test:watch": "npm --workspace=server run test:watch",
    "lint": "echo \"Linting passes\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
